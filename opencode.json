{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env*": "deny",
      ".env*": "deny"
    },
    "edit": {
      ".env*": "deny",
      "*.env*": "deny"
    },
    "bash": {
      "git push*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "npm *": "allow",
      "npx *": "allow"
    }
  }
}